[init]
	defaultBranch = main
[user]
	name = Michael Kaufmann
	email = 5276337+wulfland@users.noreply.github.com
	signingkey = /Users/mike/.ssh/id_ed25519_github
[core]
	pager = diff-so-fancy | less --tabs=4 -RFX
	whitespace = space-before-tab,tab-in-indent,tabwith=4,cr-at-eol,trailing-whitespace
[help]
	autocorrect = 20
[alias]
	lol = log --oneline --graph --decorate --all
	last = log -1
	s = switch -c
[pull]
	rebase = true
[merge]
	conflictStyle = diff3
[commit]
 	gpgSign = true
[tag]
	gpgSign = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = "/Users/mike/.config/git/allowed_signers"

